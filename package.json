  "dependencies": {
    "firebase": "^10.8.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "typescript": "^5.3.3",
    "vite": "^8.3.1"
  }
}

