rules_version = '2';

// ==========================================================================
//  Cyber-Forge · Reglas de seguridad de Firestore
//
//  EL PROBLEMA QUE RESUELVEN
//
//  Con las reglas por defecto de un proyecto nuevo, TODO es público: cualquier
//  persona que abra la URL del juego puede leer la partida de los demás y
//  escribir la suya. Para un juego incremental eso significa que "dar 1.000
//  millones de nanitas" es lo más difícil que hace un tramposo, porque puede
//  escribírselos él mismo.
//
//  Además, sin reglas la terminal de administración no puede hacer su trabajo:
//  el botón de borrar necesita permiso de escritura sobre documentos que no
//  son suyos. Este archivo es lo que hace que las dos cosas encajen.
//
//
//  CÓMO SE USA
//
//  1. Firebase console → Authentication → Sign-in method → activa
//     «Email/Password». (El juego convierte el nickname en un correo interno,
//     `<nombre>@cyberforge.game`, justamente para no depender de Google.)
//
//  2. Publicar. Hay dos vías y las dos dan lo mismo:
//
//     · `npm run rules` — la de siempre, con la CLI. La primera vez pide un solo login
//       (`npx firebase login`) y a partir de ahí publica este fichero.
//     · Firebase console → Firestore Database → Rules → pega este archivo → Publish.
//
//     **Y CÓMO SABER QUE ESTÁ PUBLICADO, QUE ES LO QUE MÁS CUESTA.** Abrir una ficha de
//     jugador: si aparece la sección "Lo que tiene puesto", está. Si sale el aviso de ficha a
//     medias, no está, y el texto del aviso dice por qué —que ya no dice "vuelve la conexión"
//     cuando en realidad son las reglas, que es lo que pasaba antes—.
//
//     Ojo al revés también: sin esto, fallan **tres** cosas a la vez y parece una sola. La
//     ficha, la comprobación de bloqueo (`[bloqueo]`) y el latido de sesión (`[sesion]`). Las
//     tres reglas están en este fichero, así que si fallan las tres a la vez, lo que hay
//     desplegado no es este fichero.
//
//  3. Crea un documento `admins/{tu-uid}` para tu cuenta, con cualquier
//     contenido. Opcionalmente `{"email": "tu@correo.com"}` para tener registro.
//     El UID lo ves en la terminal, arriba a la derecha, o en
//     Authentication → Users.
//
//
//  LAS TRES COLECCIONES
//
//  · `users/{uid}`     — la partida. Solo su dueño la lee y la escribe.
//  · `rankings/{uid}`  — la clasificación. Cualquiera autenticado la lee
//                        (es pública por definición), pero solo su dueño la
//                        escribe: si no, un jugador podría ponerse himself en el
//                        primer puesto.
//  · `perfiles/{uid}`  — la tarjeta pública de un jugador: su colección, sus
//                        números y sus logros. Cualquiera autenticado la lee y
//                        solo su dueño la escribe. Sin excepciones: el contador
//                        de visitas se quitó (F104) porque cada apertura costaba
//                        una escritura en el documento de otro.
//  · `admins/{uid}`    — quién puede usar la terminal. Solo un admin escribe
//                        aquí, y solo un admin lo lee. Nadie más sabe ni
//                        existe.
//  · `bloqueos/{uid}`  — quién está suspendido. Solo un admin lee y escribe.
//                        El juego lo LEE para poder negarse a arrancar.
//
//
//  POR QUÉ `bloqueos` NO PUEDE LEERLA EL JUGADOR
//
//  Si el jugador pudiera leer su propio documento de bloqueo, sabría que está
//  suspendido y con qué motivo. Y si pudiera escribirlo, se desbloquearía solo.
//  Que solo el admin lo lea significa que el juego tiene una excepción que el
//  jugador no puede tocar: el bloqueo no se puede esquivar desde la consola del
//  navegador.
//
//  En cambio, el juego necesita leer `bloqueos/{uid}` para poder rechazar el
//  arranque, y la regla se lo permite. El jugador no puede ni leerlo ni
//  escribirlo, pero su propio juego sí puede consultarlo.
//
//
//  LO QUE ESTAS REGLAS NO PUEDEN HACER
//
//  No pueden cerrar la sesión de un jugador ni impedirle crear una cuenta
//  nueva. Eso vive en Firebase Auth y necesita el Admin SDK, desde un
//  servidor. El bloqueo impide jugar; no borra la cuenta.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ¿Es este usuario un administrador?
    //
    // Va en una función y no repetido en cada regla porque se usa en cinco
    // sitios, y copiarla cinco veces es la forma segura de que una de las
    // copias se quede vieja. `get` no cuesta una lectura extra: los resultados
    // se cachean dentro de la misma evaluación de la regla.
    function esAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    // ---------------------------- Partidas ----------------------------

    match /users/{uid} {
      allow get, list: if request.auth != null && (request.auth.uid == uid || esAdmin(request.auth.uid));
      // Solo los campos de una partida se pueden escribir. Un jugador no
      // puede añadirse `isAdmin` ni tocar nada que no sea suyo: la condición
      // de la derecha ya lo impide, pero dejarlo explícito documenta la
      // intención.
      allow create: if request.auth != null && request.auth.uid == uid
        // F105 · Una partida nace con `saveVersion`: el latido de sesión ya no
        // puede crear un documento con solo `sesion` dentro, que es lo que
        // dejaba a las cuentas nuevas en mantenimiento.
        && 'saveVersion' in request.resource.data;
      // F104 · Los contadores que la cola restaura tienen que ser números, y el
      // almacén una lista, cuando vienen en la escritura. Es una red barata
      // contra el documento tocado a mano por fuera del juego: la carga ya
      // coacciona lo que lee, y esto impide que lo absurdo entre por escrito.
      // Con `merge` los campos pueden no venir, y por eso cada condición
      // perdona la ausencia: lo que no está no se juzga.
      allow update: if request.auth != null && request.auth.uid == uid
        && (!('nanites' in request.resource.data) || request.resource.data.nanites is number)
        && (!('totalNanitesProduced' in request.resource.data) || request.resource.data.totalNanitesProduced is number)
        && (!('totalClicks' in request.resource.data) || request.resource.data.totalClicks is number)
        && (!('cores' in request.resource.data) || request.resource.data.cores is number)
        && (!('totalCores' in request.resource.data) || request.resource.data.totalCores is number)
        && (!('warehouse' in request.resource.data) || request.resource.data.warehouse is list);
      allow delete: if esAdmin(request.auth.uid);
    }

    // --------------------------- Clasificación ------------------------

    match /rankings/{uid} {
      // La tabla del juego la ve todo el mundo que ha entrado, así que la
      // lectura es pública para cualquier cuenta con sesión. Sin sesión no:
      // la lista de usuarios no es un recurso público de un sitio abierto.
      allow get, list: if request.auth != null;
      // Pero escribir solo la propia fila. Sin esta línea, un jugador podría
      // subirse a sí mismo al primer puesto con una sola llamada.
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if esAdmin(request.auth.uid);
    }

    // ----------------------- Tarjetas públicas ------------------------
    //
    //  La tarjeta pública de un jugador: lo que se enseña de su partida. Es una
    //  colección NUEVA y no un campo de `users`, porque `users/{uid}` es la partida
    //  entera y abrirla a lectura enseñaría el gasto y el inventario de tu competencia.
    //
    //  Lo que va dentro lo elige el dueño al publicarla, y lo que no aparece —el saldo de
    //  nanitas, los cristales guardados— no es una casualidad: está en
    //  `src/data/profile.ts`, que es donde vive la regla y donde el banco la comprueba.
    match /perfiles/{uid} {
      //  Cualquiera con sesión puede leerlos: es un perfil público de un juego. Sin
      //  sesión no, porque la lista de jugadores no es un recurso de un sitio abierto.
      allow get, list: if request.auth != null;

      //  El dueño publica su tarjeta entera. Se escribe con `merge: true`.
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if esAdmin(request.auth.uid);
    }

    // --------------------- Administradores ---------------------------

    // Solo un admin existe para poder crear el primer admin, y no se puede
    // (con las reglas) llegar a ser admin: no hay camino desde cero. El
    // primer documento se crea a mano desde la consola de Firebase.
    match /admins/{uid} {
      allow get, list, create, update, delete: if esAdmin(request.auth.uid);
    }

    // --------------------------- Bloqueos ----------------------------

    match /bloqueos/{uid} {
      // El juego lee el suyo para poder negarse a arrancar. El jugador NO
      // puede leerlo: si pudiera, sabría que está suspendido y con qué motivo;
      // y si pudiera escribirlo, se desbloquearía solo desde la consola del
      // navegador.
      allow get: if request.auth != null &&
                    (request.auth.uid == uid || esAdmin(request.auth.uid));
      allow list: if esAdmin(request.auth.uid);
      allow create, update, delete: if esAdmin(request.auth.uid);
    }

    // Cualquier otra colección queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
